<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ luôn hiện splash của hệ thống (icon launcher trên một màu nền),
         bỏ qua windowBackground. Ở đây chỉ đặt màu nền cho khớp nhận diện Mầm. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/brand_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
