<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Token màu SPEC §4, cùng giá trị với CSS variables của web. -->
    <SolidColorBrush x:Key="BgApp" Color="#EEF4E8" />
    <SolidColorBrush x:Key="BgPaper" Color="#F3F7EE" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Primary" Color="#0B7A55" />
    <SolidColorBrush x:Key="PrimaryInk" Color="#0A4D37" />
    <SolidColorBrush x:Key="AccentSoft" Color="#B7F0D8" />
    <SolidColorBrush x:Key="Ink" Color="#1C2B24" />
    <SolidColorBrush x:Key="InkMuted" Color="#6B7A72" />
    <SolidColorBrush x:Key="Line" Color="#E3E9E4" />

    <!-- Nền giấy kẻ ô (.paper): DrawingBrush lặp một ô 24px có hai cạnh kẻ mảnh. -->
    <DrawingBrush x:Key="PaperBrush" TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F3F7EE">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,24,24" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#E3E9E4" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M0,0 L24,0 M0,0 L0,24" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Khối .sketch: viền đậm + bóng đổ cứng lệch 4px. -->
    <Style x:Key="SketchCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#1C2B24" ShadowDepth="4" Direction="315" BlurRadius="0" Opacity="1" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SketchButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
</ResourceDictionary>
