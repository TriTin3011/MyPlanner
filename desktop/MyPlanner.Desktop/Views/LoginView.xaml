<UserControl x:Class="MyPlanner.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MyPlanner.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}">
    <Border Style="{StaticResource SketchCard}" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Đăng nhập Mầm" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryInk}" Margin="0,0,0,16" />

            <Label Content="_Tên đăng nhập" Target="{Binding ElementName=UserNameBox}" Padding="0,0,0,4" />
            <TextBox x:Name="UserNameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6,4" Margin="0,0,0,12" />

            <Label Content="_Mật khẩu" Target="{Binding ElementName=PasswordBox}" Padding="0,0,0,4" />
            <!-- PasswordBox.Password không phải DependencyProperty nên không bind được (cố ý vì bảo mật). -->
            <PasswordBox x:Name="PasswordBox" Padding="6,4" Margin="0,0,0,12" />

            <TextBlock Text="{Binding Error}" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- IsDefault: Enter trong ô nào cũng bấm nút này. -->
            <Button Content="Đăng nhập" IsDefault="True" Style="{StaticResource SketchButton}"
                    HorizontalAlignment="Stretch" Margin="0"
                    Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=PasswordBox}" />
        </StackPanel>
    </Border>
</UserControl>
