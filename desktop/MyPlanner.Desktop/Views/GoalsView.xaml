<UserControl x:Class="MyPlanner.Desktop.Views.GoalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MyPlanner.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GoalsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="WarnBrush" Color="#C2410C" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Khối trên: Tổng quan + lọc theo lĩnh vực (trái) và Cân bằng các lĩnh vực (phải) -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <!-- Tổng quan & 8 chip lọc lĩnh vực (SPEC §7.2) -->
                <Border Style="{StaticResource SketchCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Mục tiêu &amp; tầm nhìn" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryInk}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                            <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource Primary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding SummaryLabel}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding AreaChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AreaChipViewModel}">
                                    <Button Content="{Binding DisplayText}" Command="{Binding SelectCommand}" Margin="0,0,6,6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SketchButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Cân bằng 8 lĩnh vực (SPEC §7.3) -->
                <Border Style="{StaticResource SketchCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Cân bằng các lĩnh vực" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding AreaChips}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AreaChipViewModel}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ChipLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                     Height="8" Foreground="{StaticResource Primary}" Background="{StaticResource Line}"
                                                     BorderThickness="0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0}%}"
                                                   HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource PrimaryInk}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <TextBlock Text="Đang tải mục tiêu…" Foreground="{StaticResource InkMuted}" Margin="0,0,0,8"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <!-- Danh sách thẻ mục tiêu (SPEC §7.4) -->
            <ItemsControl ItemsSource="{Binding Goals}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GoalCardRowViewModel}">
                        <Border Style="{StaticResource SketchCard}" Margin="0,0,10,12">
                            <StackPanel>
                                <!-- Hàng 1: Checkbox hoàn thành + Tiêu đề + Trạng thái -->
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoft}"
                                            CornerRadius="8" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryInk}" />
                                    </Border>
                                    <CheckBox IsChecked="{Binding Done}" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Title}">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>
                                </DockPanel>

                                <!-- Hàng 2: Lĩnh vực + Hạn -->
                                <WrapPanel Margin="0,6,0,4">
                                    <TextBlock Text="{Binding AreaText}" Foreground="{StaticResource InkMuted}"
                                               FontSize="12" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding DeadlineText}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </WrapPanel>

                                <!-- Hàng 3: Phần thưởng + Bước quá hạn + x/y bước -->
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StepsSummary}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" />
                                    <WrapPanel>
                                        <TextBlock Text="{Binding RewardText}" FontSize="12" Foreground="{StaticResource InkMuted}"
                                                   Margin="0,0,10,0" Visibility="{Binding HasReward, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding OverdueStepsText}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   Visibility="{Binding HasOverdueSteps, Converter={StaticResource BoolToVis}}" />
                                    </WrapPanel>
                                </DockPanel>

                                <!-- Hàng 4: Hai thanh Tiến độ & Thời gian -->
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,6,0">
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StepPercent, StringFormat={}{0}%}"
                                                       FontSize="11" FontWeight="Bold" />
                                            <TextBlock Text="Tiến độ" FontSize="11" Foreground="{StaticResource InkMuted}" />
                                        </DockPanel>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding StepPercent, Mode=OneWay}"
                                                     Height="6" Foreground="{StaticResource Primary}" Background="{StaticResource Line}"
                                                     BorderThickness="0" />
                                    </StackPanel>

                                    <StackPanel Margin="6,0,0,0">
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimePercent, StringFormat={}{0}%}"
                                                       FontSize="11" FontWeight="Bold" />
                                            <TextBlock Text="Thời gian" FontSize="11" Foreground="{StaticResource InkMuted}" />
                                        </DockPanel>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding TimePercent, Mode=OneWay}"
                                                     Height="6" Background="{StaticResource Line}" BorderThickness="0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Foreground" Value="{StaticResource Primary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Behind}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Cảnh báo chậm kế hoạch (SPEC §13.4, BE đã tính sẵn Behind) -->
                                <TextBlock Text="Đang chậm hơn kế hoạch" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0"
                                           Visibility="{Binding Behind, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
