<UserControl x:Class="MyPlanner.Desktop.Views.YearView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MyPlanner.Desktop.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:YearViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
        <SolidColorBrush x:Key="DangerBgBrush" Color="#FDE8E8" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- Header: năm + điều hướng + tổng tiến độ cả năm (SPEC §10.1) -->
            <Border Style="{StaticResource SketchCard}" Margin="0,0,0,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="‹" Command="{Binding PreviousYearCommand}" Style="{StaticResource SketchButton}" ToolTip="Năm trước" />
                        <Button Content="Năm nay" Command="{Binding ThisYearCommand}" Style="{StaticResource SketchButton}" />
                        <Button Content="›" Command="{Binding NextYearCommand}" Style="{StaticResource SketchButton}" ToolTip="Năm sau" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource Primary}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryInk}">
                                <Run Text="Kế hoạch năm " /><Run Text="{Binding Year, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding SummaryLabel}" Foreground="{StaticResource InkMuted}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <TextBlock Text="Đang tải kế hoạch năm…" Foreground="{StaticResource InkMuted}" Margin="0,0,0,8"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <!-- Khối giữa: Từ khoá & tầm nhìn (trái, §10.2) + Biểu đồ Tiến độ 12 tháng (phải, §10.3) -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <Border Style="{StaticResource SketchCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TỪ KHOÁ CỦA NĂM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkMuted}" />
                        <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                                 FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryInk}"
                                 Padding="8,6" Margin="0,4,0,12" BorderBrush="{StaticResource Ink}" BorderThickness="2" />

                        <TextBlock Text="TẦM NHÌN NĂM NAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource InkMuted}" />
                        <TextBox Text="{Binding Vision, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="74" VerticalScrollBarVisibility="Auto"
                                 Padding="8,6" Margin="0,4,0,10" BorderBrush="{StaticResource Ink}" BorderThickness="2" />

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Lưu từ khoá &amp; tầm nhìn"
                                    Command="{Binding SaveMetaCommand}" Style="{StaticResource SketchButton}" Margin="0" />
                            <TextBlock Text="{Binding MetaStatus}" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="Bold" Foreground="{StaticResource Primary}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SketchCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowBars}" VerticalAlignment="Center"
                                      Content="Dạng cột" ToolTip="Đổi giữa biểu đồ đường và cột" />
                            <TextBlock Text="Tiến độ 12 tháng" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <lvc:CartesianChart Height="175" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                            LegendPosition="Bottom" AutomationProperties.Name="Biểu đồ kế hoạch đã xong và tổng kế hoạch 12 tháng" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Lưới 12 MonthCard (SPEC §10.4) -->
            <TextBlock Text="Kế hoạch từng tháng" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryInk}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Months}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:YearMonthCardViewModel}">
                        <Border Style="{StaticResource SketchCard}" Margin="0,0,10,12">
                            <Expander IsExpanded="{Binding IsOpen}">
                                <Expander.Header>
                                    <StackPanel Width="220">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding DeadlineBadge}" FontSize="11"
                                                       FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="6,0,0,0"
                                                       Visibility="{Binding HasDeadlines, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressLabel}" FontSize="12"
                                                       FontWeight="Bold" Foreground="{StaticResource InkMuted}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding MonthTitle}" FontWeight="Bold" FontSize="15" />
                                                <Border Background="{StaticResource Primary}" CornerRadius="6" Padding="6,1" Margin="6,0,0,0"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Nay" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                     Height="5" Margin="0,4,0,0" Foreground="{StaticResource Primary}"
                                                     Background="{StaticResource Line}" BorderThickness="0" />
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel Margin="0,8,0,0">
                                    <!-- Các DeadlineRow của tháng (lấy từ Goal/GoalStep) -->
                                    <ItemsControl ItemsSource="{Binding Deadlines}" Margin="0,0,0,6"
                                                  Visibility="{Binding HasDeadlines, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource DangerBgBrush}" CornerRadius="6" Padding="6,4" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Mode=OneWay}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Danh sách kế hoạch trong tháng -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:YearPlanItemRowViewModel}">
                                                <CheckBox IsChecked="{Binding Done}" Margin="0,3"
                                                          AutomationProperties.Name="{Binding Title}">
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Ô thêm kế hoạch mới cho tháng -->
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="+" Command="{Binding AddItemCommand}"
                                                Style="{StaticResource SketchButton}" Margin="4,0,0,0" ToolTip="Thêm kế hoạch" />
                                        <TextBox Text="{Binding NewItemTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,4" BorderBrush="{StaticResource Ink}" BorderThickness="1.5"
                                                 ToolTip="Nhập kế hoạch cho tháng này" />
                                    </DockPanel>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
