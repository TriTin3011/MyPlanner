<UserControl x:Class="MyPlanner.Desktop.Views.SplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="clr-namespace:MyPlanner.Desktop.Hosting"
             Background="{StaticResource PaperBrush}">
    <UserControl.Resources>
        <hosting:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <!-- Ba chấm nhún lần lượt; chấm cuối vừa hạ xuống (0,86s) thì cả logo nhún một cái, lặp mỗi 1,7 giây. -->
        <Storyboard x:Key="LoopStoryboard" RepeatBehavior="Forever" Duration="0:0:1.7">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoMove" Storyboard.TargetProperty="Y" BeginTime="0:0:0.86">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.12" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="-10" KeySpline="0.2,0.7,0.4,1" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" KeySpline="0.6,0,0.8,0.4" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX" BeginTime="0:0:0.86">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1.06" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.97" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1.03" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.62" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.86">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0.92" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1.04" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0.96" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.62" Value="1" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1Move" Storyboard.TargetProperty="Y">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="-4" KeySpline="0.3,0,0.3,1" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" KeySpline="0.5,0,0.7,1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0.35" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2Move" Storyboard.TargetProperty="Y" BeginTime="0:0:0.18">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="-4" KeySpline="0.3,0,0.3,1" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" KeySpline="0.5,0,0.7,1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.18">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0.35" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3Move" Storyboard.TargetProperty="Y" BeginTime="0:0:0.36">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.25" Value="-4" KeySpline="0.3,0,0.3,1" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="0" KeySpline="0.5,0,0.7,1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.36">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.35" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="0.35" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24">
        <!-- Logo vẽ lại từ docs/brand/logo-vong.svg; Viewbox phóng hệ toạ độ 64 đơn vị lên 132px. -->
        <Viewbox Width="132" Height="132" Margin="0,0,0,14" AutomationProperties.Name="Logo Mầm"
                 RenderTransformOrigin="0.5,1">
            <!-- Gốc biến đổi ở đáy logo để khi nén, logo như đang tì xuống mặt đất. -->
            <Viewbox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="LogoScale" />
                    <TranslateTransform x:Name="LogoMove" />
                </TransformGroup>
            </Viewbox.RenderTransform>
            <Canvas Width="64" Height="64">
                <Ellipse x:Name="LogoDisc" Canvas.Left="10" Canvas.Top="12" Width="44" Height="44" Fill="#EEF8F2" />
                <Path x:Name="LogoRing" Data="M32,12 A22,22 0 1 1 12.5,24" Stroke="#0B7A55" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="LogoLeaf" Data="M32,12 C31,7 35,3 41,3 C41,8 37,12 32,12 Z" Fill="#22A06B" Stroke="#0A4D37"
                      StrokeThickness="2" StrokeLineJoin="Round" />
                <Ellipse x:Name="Dot1" Canvas.Left="19.8" Canvas.Top="32.8" Width="6.4" Height="6.4" Fill="#0A4D37">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Dot1Move" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot2" Canvas.Left="28.8" Canvas.Top="32.8" Width="6.4" Height="6.4" Fill="#0A4D37">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Dot2Move" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Dot3" Canvas.Left="37.8" Canvas.Top="32.8" Width="6.4" Height="6.4" Fill="#22A06B">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Dot3Move" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Viewbox>

        <!-- Mỗi phông có hai file theo bảng chữ: ký tự thiếu ở file Latin sẽ tự lấy từ file tiếng Việt. -->
        <TextBlock Text="Mầm" FontSize="32" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,0,0,8"
                   FontFamily="pack://application:,,,/Mam;component/Assets/Fonts/#Mam Display Latin, pack://application:,,,/Mam;component/Assets/Fonts/#Mam Display Viet" />

        <!-- Thanh tiến độ nét vẽ tay. Co giãn bằng ScaleX nên không bắt WPF tính lại layout mỗi khung hình. -->
        <Border x:Name="Bar" Width="280" Height="14" Margin="0,0,0,10" HorizontalAlignment="Center"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Ink}" BorderThickness="2"
                CornerRadius="7" AutomationProperties.Name="Tiến độ khởi động">
            <Grid ClipToBounds="True">
                <Border x:Name="BarFill" Background="{StaticResource Primary}" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="BarScale" ScaleX="0" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Border>

        <!-- LiveSetting: trình đọc màn hình đọc lại mỗi khi trạng thái đổi. -->
        <TextBlock x:Name="Status" Text="{Binding StartupMessage, TargetNullValue='Đang mở giao diện...'}"
                   Foreground="{StaticResource InkMuted}" HorizontalAlignment="Center"
                   FontSize="13" FontWeight="Medium"
                   FontFamily="pack://application:,,,/Mam;component/Assets/Fonts/#Mam Body Latin, pack://application:,,,/Mam;component/Assets/Fonts/#Mam Body Viet"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding StartupError}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Medium"
                   FontFamily="pack://application:,,,/Mam;component/Assets/Fonts/#Mam Body Latin, pack://application:,,,/Mam;component/Assets/Fonts/#Mam Body Viet"
                   Margin="0,4,0,12" AutomationProperties.LiveSetting="Assertive"
                   Visibility="{Binding StartupError, Converter={StaticResource NullToCollapsed}}" />
        <Button Content="Thử lại" Command="{Binding StartCommand}" Style="{StaticResource SketchButton}"
                HorizontalAlignment="Center" Margin="0"
                Visibility="{Binding StartupError, Converter={StaticResource NullToCollapsed}}" />
    </StackPanel>
</UserControl>
