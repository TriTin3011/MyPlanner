<UserControl x:Class="MyPlanner.Desktop.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MyPlanner.Desktop.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StatsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
        <SolidColorBrush x:Key="MutedBar" Color="#C9CDD1" />
        <SolidColorBrush x:Key="Heat0" Color="#E8F3EE" />
        <SolidColorBrush x:Key="Heat1" Color="#B6D7CC" />
        <SolidColorBrush x:Key="Heat2" Color="#86BCAA" />
        <SolidColorBrush x:Key="Heat3" Color="#4A9C80" />
        <SolidColorBrush x:Key="GoalNotStarted" Color="#C9E4D8" />
        <SolidColorBrush x:Key="GoalInProgress" Color="#69B598" />

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryInk}" />
        </Style>
        <!-- Tăng màu xanh, giảm màu đỏ; DataContext của TextBlock là một StatsDelta. -->
        <Style x:Key="DeltaText" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDown}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ThinBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Primary}" />
            <Setter Property="Background" Value="{StaticResource Line}" />
        </Style>

        <!-- Bảng dùng chung cho toggle "Bảng" của mọi thẻ. -->
        <DataTemplate DataType="{x:Type vm:StatsTable}">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                    <!-- Chừa đúng bề rộng thanh cuộn của phần thân để cột tiêu đề thẳng hàng với cột dữ liệu. -->
                    <ItemsControl ItemsSource="{Binding Headers}" Margin="0,0,17,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Mode=OneWay}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Visible">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding}" Margin="0,3">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Mode=OneWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- Một ô heatmap: màu theo Level do BE tính, ô hôm nay có viền đậm. -->
        <Style x:Key="HeatCell" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="0"><Setter Property="Background" Value="{StaticResource Heat0}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="1"><Setter Property="Background" Value="{StaticResource Heat1}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="2"><Setter Property="Background" Value="{StaticResource Heat2}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Background" Value="{StaticResource Heat3}" /></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="4"><Setter Property="Background" Value="{StaticResource Primary}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,8">
            <!-- Header + chọn khoảng thời gian -->
            <DockPanel Margin="0,0,0,12">
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}"
                          DisplayMemberPath="Label" Width="110" VerticalAlignment="Center" FontWeight="Bold"
                          AutomationProperties.Name="Khoảng thời gian thống kê" />
                <StackPanel>
                    <TextBlock Text="Thống kê" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryInk}" />
                    <TextBlock Text="{Binding PeriodLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
            <TextBlock Text="Đang tải thống kê…" Foreground="{StaticResource InkMuted}" Margin="0,0,0,8"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <Button Content="Thử lại" Command="{Binding LoadCommand}" Style="{StaticResource SketchButton}"
                    HorizontalAlignment="Left" Margin="0,0,0,8">
                <Button.Visibility>
                    <Binding Path="Error" FallbackValue="Collapsed" TargetNullValue="Collapsed">
                        <Binding.Converter>
                            <local:NullToCollapsedConverter xmlns:local="clr-namespace:MyPlanner.Desktop.Hosting" />
                        </Binding.Converter>
                    </Binding>
                </Button.Visibility>
            </Button>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <!-- Hero (§11.1) -->
                <Border Style="{StaticResource SketchCard}" Margin="0,0,0,14">
                    <DockPanel>
                        <lvc:CartesianChart DockPanel.Dock="Right" Width="190" Height="64" Series="{Binding SparkSeries}"
                                            XAxes="{Binding HiddenXAxes}" YAxes="{Binding SparkYAxes}" TooltipPosition="Hidden"
                                            PreviewMouseWheel="ForwardWheelToPage"
                                            AutomationProperties.Name="Đường tỉ lệ hoàn thành theo từng tuần" />
                        <StackPanel>
                            <TextBlock Text="{Binding HeroTitle}" Style="{StaticResource KpiLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CompletionPercent, StringFormat={}{0}%}" FontSize="44" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryInk}" />
                                <TextBlock DataContext="{Binding HeroDelta}" Style="{StaticResource DeltaText}"
                                           VerticalAlignment="Bottom" Margin="12,0,4,11" />
                                <TextBlock Text="{Binding HeroCompare}" FontSize="12" Foreground="{StaticResource InkMuted}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,11" />
                            </StackPanel>
                            <TextBlock Text="{Binding HeroSummary}" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Ba KPI (§11.2) -->
                <UniformGrid Columns="3" Margin="0,0,0,14">
                    <Border Style="{StaticResource SketchCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="✓ VIỆC ĐÃ XONG" Style="{StaticResource KpiLabel}" />
                            <TextBlock Text="{Binding TasksDone}" Style="{StaticResource KpiValue}" />
                            <TextBlock DataContext="{Binding TasksDelta}" Style="{StaticResource DeltaText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SketchCard}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="CHUỖI HOẠT ĐỘNG" Style="{StaticResource KpiLabel}" />
                            <TextBlock Text="{Binding StreakLabel}" Style="{StaticResource KpiValue}" />
                            <TextBlock Text="{Binding LongestStreakLabel}" FontSize="12" Foreground="{StaticResource InkMuted}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SketchCard}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="✓ THÓI QUEN" Style="{StaticResource KpiLabel}" />
                            <TextBlock Text="{Binding HabitPercent, StringFormat={}{0}%}" Style="{StaticResource KpiValue}" />
                            <TextBlock DataContext="{Binding HabitDelta}" Style="{StaticResource DeltaText}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Xu hướng (§11.3) -->
                <Border Style="{StaticResource SketchCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <CheckBox DockPanel.Dock="Right" Content="Bảng" IsChecked="{Binding ShowTrendTable}" VerticalAlignment="Center" />
                            <CheckBox DockPanel.Dock="Right" Content="Dạng cột" IsChecked="{Binding ShowBars}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Xu hướng hoàn thành" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="{Binding TrendAverage}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource InkMuted}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <lvc:CartesianChart Height="200" Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}" YAxes="{Binding TrendYAxes}"
                                            PreviewMouseWheel="ForwardWheelToPage"
                                            AutomationProperties.Name="Biểu đồ tỉ lệ hoàn thành theo tuần">
                            <lvc:CartesianChart.Style>
                                <Style TargetType="lvc:CartesianChart">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTrendTable}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </lvc:CartesianChart.Style>
                        </lvc:CartesianChart>
                        <ContentControl Content="{Binding TrendTable}" Focusable="False"
                                        Visibility="{Binding ShowTrendTable, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Heatmap (§11.4) + Năng suất theo thứ (§11.5) -->
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Border Style="{StaticResource SketchCard}" Margin="0,0,7,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <CheckBox DockPanel.Dock="Right" Content="Bảng" IsChecked="{Binding ShowHeatmapTable}" VerticalAlignment="Center" />
                                <TextBlock Text="Nhịp làm việc hằng ngày" Style="{StaticResource CardTitle}" />
                            </DockPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowHeatmapTable}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <DockPanel>
                                    <!-- Nhãn hàng: chỉ ghi T2, T4, T6, CN (SPEC §11.4). -->
                                    <Grid DockPanel.Dock="Left" Width="26" Margin="0,18,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="19" /><RowDefinition Height="19" /><RowDefinition Height="19" />
                                            <RowDefinition Height="19" /><RowDefinition Height="19" /><RowDefinition Height="19" /><RowDefinition Height="19" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="T2" FontSize="10" Foreground="{StaticResource InkMuted}" />
                                        <TextBlock Grid.Row="2" Text="T4" FontSize="10" Foreground="{StaticResource InkMuted}" />
                                        <TextBlock Grid.Row="4" Text="T6" FontSize="10" Foreground="{StaticResource InkMuted}" />
                                        <TextBlock Grid.Row="6" Text="CN" FontSize="10" Foreground="{StaticResource InkMuted}" />
                                    </Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="ForwardWheelToPage" ScrollChanged="HeatmapScroll_ScrollChanged">
                                        <ItemsControl ItemsSource="{Binding HeatmapColumns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:HeatmapColumn}">
                                                    <StackPanel Width="19">
                                                        <!-- Canvas không cắt chữ nên nhãn tháng được tràn sang cột bên cạnh. -->
                                                        <Canvas Height="18">
                                                            <TextBlock Text="{Binding MonthLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource InkMuted}" />
                                                        </Canvas>
                                                        <ItemsControl ItemsSource="{Binding Cells}" Focusable="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:HeatmapCell}">
                                                                    <Border Style="{StaticResource HeatCell}" HorizontalAlignment="Left" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <TextBlock Text="Ít" FontSize="11" Foreground="{StaticResource InkMuted}" Margin="0,0,4,0" />
                                    <Border Width="12" Height="12" CornerRadius="2" Margin="1,0" Background="{StaticResource Heat0}" />
                                    <Border Width="12" Height="12" CornerRadius="2" Margin="1,0" Background="{StaticResource Heat1}" />
                                    <Border Width="12" Height="12" CornerRadius="2" Margin="1,0" Background="{StaticResource Heat2}" />
                                    <Border Width="12" Height="12" CornerRadius="2" Margin="1,0" Background="{StaticResource Heat3}" />
                                    <Border Width="12" Height="12" CornerRadius="2" Margin="1,0" Background="{StaticResource Primary}" />
                                    <TextBlock Text="Nhiều" FontSize="11" Foreground="{StaticResource InkMuted}" Margin="4,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <ContentControl Content="{Binding HeatmapTable}" Focusable="False"
                                            Visibility="{Binding ShowHeatmapTable, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SketchCard}" Margin="7,0,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <CheckBox DockPanel.Dock="Right" Content="Bảng" IsChecked="{Binding ShowWeekdayTable}" VerticalAlignment="Center" />
                                <TextBlock Text="Năng suất theo thứ" Style="{StaticResource CardTitle}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Weekdays}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowWeekdayTable}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WeekdayBar}">
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DayLabel" Text="{Binding Label}" FontSize="13" />
                                            <ProgressBar x:Name="DayBar" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BarPercent, Mode=OneWay}"
                                                         Height="15" BorderThickness="0" Background="Transparent" Foreground="{StaticResource MutedBar}"
                                                         AutomationProperties.Name="{Binding Label}" />
                                            <TextBlock x:Name="DayValue" Grid.Column="2" Text="{Binding Value}" FontSize="13" TextAlignment="Right" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsTop}" Value="True">
                                                <Setter TargetName="DayBar" Property="Foreground" Value="{StaticResource Primary}" />
                                                <Setter TargetName="DayLabel" Property="FontWeight" Value="Bold" />
                                                <Setter TargetName="DayValue" Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ContentControl Content="{Binding WeekdayTable}" Focusable="False"
                                            Visibility="{Binding ShowWeekdayTable, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Thói quen (§11.6) + Mục tiêu (§11.7) -->
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource SketchCard}" Margin="0,0,7,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <CheckBox DockPanel.Dock="Right" Content="Bảng" IsChecked="{Binding ShowHabitTable}" VerticalAlignment="Center" />
                                <TextBlock Text="Độ đều đặn của thói quen" Style="{StaticResource CardTitle}" />
                            </DockPanel>
                            <TextBlock Text="Chưa có thói quen trong khoảng này." Foreground="{StaticResource InkMuted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasHabits}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Habits}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowHabitTable}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HabitConsistencyRow}">
                                        <StackPanel Margin="0,0,0,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Percent, StringFormat={}{0}%}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Percent, Mode=OneWay}" Margin="0,4"
                                                         AutomationProperties.Name="{Binding Title}" />
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource InkMuted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ContentControl Content="{Binding HabitTable}" Focusable="False"
                                            Visibility="{Binding ShowHabitTable, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SketchCard}" Margin="7,0,0,0">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Content="Bảng" IsChecked="{Binding ShowGoalTable}" VerticalAlignment="Center" />
                                <TextBlock Text="Mục tiêu của bạn" Style="{StaticResource CardTitle}" />
                            </DockPanel>
                            <TextBlock Text="{Binding GoalsSubtitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkMuted}" Margin="0,2,0,8" />
                            <StackPanel Visibility="{Binding HasGoals, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowGoalTable}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid Height="14" AutomationProperties.Name="Tỉ lệ mục tiêu theo trạng thái">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding NotStartedWidth}" />
                                            <ColumnDefinition Width="{Binding InProgressWidth}" />
                                            <ColumnDefinition Width="{Binding DoneWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource GoalNotStarted}" />
                                        <Border Grid.Column="1" Background="{StaticResource GoalInProgress}" />
                                        <Border Grid.Column="2" Background="{StaticResource Primary}" />
                                    </Grid>
                                    <WrapPanel Margin="0,6,0,10">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                            <Border Width="10" Height="10" Background="{StaticResource GoalNotStarted}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding NotStartedLabel}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,2">
                                            <Border Width="10" Height="10" Background="{StaticResource GoalInProgress}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding InProgressLabel}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <Border Width="10" Height="10" Background="{StaticResource Primary}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding DoneLabel}" FontSize="12" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="Theo lĩnh vực" FontWeight="Bold" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding GoalAreas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:GoalAreaRow}">
                                                <StackPanel Margin="0,0,0,9">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}" FontSize="12" Foreground="{StaticResource InkMuted}" />
                                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Percent, Mode=OneWay}" Margin="0,3,0,0"
                                                                 AutomationProperties.Name="{Binding Label}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ContentControl Content="{Binding GoalTable}" Focusable="False"
                                                Visibility="{Binding ShowGoalTable, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
