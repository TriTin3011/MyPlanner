<Window x:Class="MyPlanner.Desktop.Views.PomodoroFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="{StaticResource Surface}"
        BorderBrush="{StaticResource Ink}"
        BorderThickness="2"
        MouseLeftButtonDown="OnDrag">
    <Window.Resources>
        <Style x:Key="FloatButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <StackPanel Orientation="Horizontal" Margin="12,6,6,6" VerticalAlignment="Center">
        <StackPanel MinWidth="92" VerticalAlignment="Center">
            <TextBlock x:Name="Clock" Text="00:00" FontSize="22" FontWeight="ExtraBold"
                       Foreground="{StaticResource Ink}" />
            <TextBlock x:Name="Status" FontSize="11" FontWeight="Bold" MaxWidth="120"
                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkMuted}" />
        </StackPanel>
        <Button x:Name="ToggleButton" Style="{StaticResource FloatButton}" Content="&#xE768;"
                Foreground="{StaticResource Primary}" Click="OnToggle" />
        <Button x:Name="ExpandButton" Style="{StaticResource FloatButton}" Content="&#xE740;" Click="OnExpand" />
        <Button x:Name="CloseButton" Style="{StaticResource FloatButton}" Content="&#xE8BB;" Click="OnClose" />
    </StackPanel>
</Window>
